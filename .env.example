# Backend hanya berjalan di loopback untuk development lokal.
API_HOST=127.0.0.1
API_PORT=3101
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kindsight_local
DB_USER=kindsight_app
DB_PASSWORD=replace-with-a-local-password
# Opsional, diperlukan db:setup jika akun root memiliki password.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Origin frontend yang diizinkan untuk login/logout lokal.
APP_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5176,http://localhost:5176,http://127.0.0.1:5180,http://localhost:5180
# Opsional untuk admin:create; tanpa ADMIN_PASSWORD dibuat password acak.
ADMIN_EMAIL=admin@kindsight.local
ADMIN_NAME=Kindsight Admin
# ADMIN_PASSWORD=
