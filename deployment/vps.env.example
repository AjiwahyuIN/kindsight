# Copy to /www/wwwroot/kindsight/.env on the VPS, outside the public dist directory.
# Replace all CHANGE_ME values privately before starting the API.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3101
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kindsight
DB_USER=kindsight_app
DB_PASSWORD=CHANGE_ME_WITH_VPS_DATABASE_PASSWORD
APP_ORIGINS=https://CHANGE_ME_DOMAIN
