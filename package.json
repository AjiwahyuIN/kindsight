{
  "name": "kindsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "db:setup": "node server/db/setup.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:check": "node server/db/check.js",
    "test:api": "node --test server/test/*.test.js",
    "test:db": "node --test server/test/database.integration.js",
    "admin:create": "node server/db/create-admin.js",
    "test:auth": "node --test server/test/auth.integration.js",
    "test:crud": "node --test server/test/fundraising.integration.js",
    "test:dashboard": "node --test server/test/dashboard.integration.js",
    "test:content": "node --test server/test/landing.integration.js",
    "test:uploads": "node --test server/test/uploads.integration.js",
    "typecheck": "tsc --noEmit",
    "dev:legacy": "vite --config vite.legacy.config.js --host 127.0.0.1 --port 5175 --strictPort",
    "build:legacy": "vite build --config vite.legacy.config.js",
    "preview:legacy": "vite preview --config vite.legacy.config.js --host 127.0.0.1 --port 5181 --strictPort",
    "test:frontend": "node --test tests/*.test.mjs",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "content:contract": "node scripts/content-contract.mjs",
    "test:integration": "node --import tsx --test tests/react-api.integration.mjs",
    "organization:create-user": "node server/db/create-organization-user.js",
    "test:organizations": "node --test server/test/organizations.integration.js",
    "test:admin": "node --import tsx --test server/test/admin-overview.integration.ts",
    "test:demo": "node --import tsx --test server/test/demo-requests.integration.ts",
    "test:organization-management": "node --import tsx --test server/test/organization-management.integration.ts",
    "test:users": "node --import tsx --test server/test/user-management.integration.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pug": "^3.0.4",
    "sass": "^1.105.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pug": "^0.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sharp": "^0.35.5"
  }
}
